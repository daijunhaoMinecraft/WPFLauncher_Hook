<UserControl x:Class="Mcl.Core.Dotnetdetour.UI.Controls.LanCloudSavePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="200"
             Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Padding="10" Margin="10,6,10,0">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="云存档" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="未创建"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,8" Text="尚未关联云端存档。" />
            <UniformGrid Columns="3">
                <Button x:Name="UploadButton" Content="云端上传" Margin="0,0,5,0"
                        MinHeight="28" Padding="6,3" FontSize="12"
                        Style="{StaticResource PrimaryButton}"
                        automation:AutomationProperties.Name="上传本地联机云存档"
                        Click="Upload_Click" />
                <Button x:Name="DownloadButton" Content="下载" Margin="0,0,5,0"
                        MinHeight="28" Padding="6,3" FontSize="12"
                        automation:AutomationProperties.Name="下载本地联机云存档"
                        Click="Download_Click" />
                <Button x:Name="ManageButton" Content="管理"
                        MinHeight="28" Padding="6,3" FontSize="12"
                        automation:AutomationProperties.Name="打开云存档管理"
                        Click="Manage_Click" />
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
