<Window x:Class="Mcl.Core.Dotnetdetour.UI.Controls.ServerPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器操作" Height="240" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="服务器操作" Style="{StaticResource PageTitle}" FontSize="20"/>
        <CheckBox x:Name="TopMostCheck" 
                  Content="置顶"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,4,0,0"
                  Checked="OnTopMostChanged"
                  Unchecked="OnTopMostChanged"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryText}" Margin="0,12,0,20"
                   Text="服务器正在运行。关闭服务器会断开当前连接，请先确认游戏进度已保存。"/>
        <Button x:Name="CloseButton" Grid.Row="2" Style="{StaticResource DangerButton}"
                Content="关闭服务器"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="120"
                Margin="0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>