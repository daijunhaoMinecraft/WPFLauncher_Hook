<Window x:Class="WPFLauncher.Manager.ProcessLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程运行日志" Height="500" Width="800"
        Background="#202020" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 (标题 + 按钮组) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleTextBlock" Text="启动日志 - 等待进程..." 
                       Foreground="White" FontSize="16" FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 结束进程按钮 (红色警告风格) -->
                <Button x:Name="KillProcessButton" Content="结束进程" Margin="0,0,10,0" Padding="15,5" 
                        Background="#C50F1F" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="KillProcess_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <!-- 导出日志按钮 -->
                <Button Content="导出日志" Padding="15,5" 
                        Background="#333333" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="ExportLog_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 日志显示区 -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
            <ScrollViewer x:Name="LogScroller" ScrollChanged="LogScroller_ScrollChanged" Margin="5">
                <TextBox x:Name="LogTextBox" 
                         Background="Transparent" BorderThickness="0"
                         Foreground="#D4D4D4" FontFamily="Consolas" FontSize="13"
                         IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>