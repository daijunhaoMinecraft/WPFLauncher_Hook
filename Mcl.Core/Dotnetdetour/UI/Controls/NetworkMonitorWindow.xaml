<Window x:Class="Mcl.Core.Dotnetdetour.UI.Controls.NetworkMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="异地组网状态查看器 - Mcl Network Monitor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <!-- 1. WinUI3 输入框样式 -->
        <Style TargetType="TextBox">
            <!-- 统一设置上下左右内边距 -->
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- 注意：Padding 必须设置在 Border 上，绝不能设在 PART_ContentHost 的 Margin 上 -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <!-- 同理，Padding 设置在外层 Border -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. WinUI3 按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FDFDFD"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EBEBEB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. WinUI3 主按钮 (蓝色) 必须保留这个 Key！ -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 1. 彻底重写表头样式 (去除老式的垂直分割线，变成现代的扁平风格) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#606060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 彻底重写列表项样式 (修复无法选中、无蓝色背景、左侧对齐的问题) -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/> <!-- 必须拉伸，否则背景色不铺满全行 -->
            <Setter Property="Margin" Value="4,2,4,2"/> <!-- 外部留出间距，呈现 Win11 悬浮卡片感 -->
            <Setter Property="Padding" Value="12,8,12,8"/> <!-- 内部文字与边框的距离 -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- 这个 Border 负责呈现圆角和选中后的蓝色背景 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <!-- 确保内容正确继承 Padding -->
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬浮时的浅灰色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                            <!-- 选中时的 WinUI 3 浅蓝色背景 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F2FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 去除 ListView 默认白底和边框 -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息 -->
        <Grid Grid.Row="0" Background="White" Margin="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Text="正在初始化..." FontSize="16" FontWeight="Bold" Foreground="#1A1A1A" Padding="24,16"/>
            <CheckBox x:Name="TopMostCheck" Content="置顶窗口" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0" Checked="OnTopMostChanged" Unchecked="OnTopMostChanged"/>
        </Grid>

        <!-- 玩家列表 -->
        <Border Grid.Row="1" Background="White" Margin="24,24,24,0" CornerRadius="8" BorderBrush="#E5E5E5" BorderThickness="1">
            <ListView x:Name="PlayerListView" BorderThickness="0" Background="Transparent" Margin="4">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制内网 IP" Click="CopySelectedIp"/>
                        <MenuItem Header="复制 PeerID" Click="CopySelectedPeerId"/>
                        <MenuItem Header="复制玩家详细信息" FontWeight="Bold" Click="CopySelectedInfo"/>
                        <Separator/>
                        <MenuItem Header="刷新列表 (F5)" Click="OnRefreshClick"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="玩家名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="内网 IP 地址" Width="150" DisplayMemberBinding="{Binding VirtualIp}"/>
                        <GridViewColumn Header="连接状态" Width="150" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="User ID" Width="120" DisplayMemberBinding="{Binding UserID}"/>
                        <GridViewColumn Header="WebRTC PeerId" Width="200" DisplayMemberBinding="{Binding PeerId}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部控制 -->
        <Border Grid.Row="2" Background="#F3F3F3" Padding="24,16">
            <Grid>
                <Button Content="🔄 刷新列表" Width="140" HorizontalAlignment="Left" ToolTip="手动刷新玩家列表 (F5)" Click="OnRefreshClick"/>
                <Button Content="⏹ 停止服务" Width="140" HorizontalAlignment="Right" ToolTip="停止组网服务并断开所有连接" Background="#D13438" Foreground="White" BorderThickness="0" Click="BtnStop_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>