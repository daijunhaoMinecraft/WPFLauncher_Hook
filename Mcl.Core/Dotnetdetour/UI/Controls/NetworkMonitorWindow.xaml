<Window x:Class="Mcl.Core.Dotnetdetour.UI.Controls.NetworkMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="异地组网状态查看器 - Mcl Network Monitor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White" Margin="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Text="正在初始化..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Padding="24,16"/>
            <CheckBox x:Name="TopMostCheck" Content="置顶窗口" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0" Checked="OnTopMostChanged" Unchecked="OnTopMostChanged"/>
        </Grid>
        <Border Grid.Row="1" Background="White" Margin="24,24,24,0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ListView x:Name="PlayerListView" BorderThickness="0" Background="Transparent" Margin="4">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制内网 IP" Click="CopySelectedIp"/>
                        <MenuItem Header="复制 PeerID" Click="CopySelectedPeerId"/>
                        <MenuItem Header="复制玩家详细信息" FontWeight="Bold" Click="CopySelectedInfo"/>
                        <Separator/>
                        <MenuItem Header="刷新列表 (F5)" Click="OnRefreshClick"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="玩家名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="内网 IP 地址" Width="150" DisplayMemberBinding="{Binding VirtualIp}"/>
                        <GridViewColumn Header="连接状态" Width="150" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="User ID" Width="120" DisplayMemberBinding="{Binding UserID}"/>
                        <GridViewColumn Header="WebRTC PeerId" Width="200" DisplayMemberBinding="{Binding PeerId}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" Padding="24,16">
            <Grid>
                <Button Content="🔄 刷新列表" Width="140" HorizontalAlignment="Left" ToolTip="手动刷新玩家列表 (F5)" Click="OnRefreshClick"/>
                <Button Content="⏹ 停止服务" Width="140" HorizontalAlignment="Right" ToolTip="停止组网服务并断开所有连接" Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0" Click="BtnStop_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>