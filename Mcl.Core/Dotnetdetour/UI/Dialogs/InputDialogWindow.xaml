<Window x:Class="Mcl.Core.Dotnetdetour.UI.Dialogs.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请输入" Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E5E5E5" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Direction="270"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="请输入存档名称" FontWeight="Bold" FontSize="16" Foreground="#333333" Margin="20,20,20,10"/>

            <!-- 输入框 -->
            <Border Grid.Row="1" Margin="20,10,20,10" Background="#F5F6F7" CornerRadius="6" BorderBrush="#E5E5E5" BorderThickness="1">
                <TextBox x:Name="InputTextBox" Background="Transparent" BorderThickness="0" FontSize="14" Padding="10" 
                         VerticalAlignment="Center" Foreground="#333333" />
            </Border>

            <!-- 按钮 -->
            <Border Grid.Row="2" Background="#F9F9F9" CornerRadius="0,0,12,12">
                <Grid>
                    <Border VerticalAlignment="Top" Height="1" Background="#E5E5E5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="取消" Width="80" Height="32" Margin="0,0,10,0" Background="#F1F3F4" Foreground="#333333" Style="{StaticResource RoundedBtn}" Click="BtnCancel_Click"/>
                        <Button Content="确定" Width="80" Height="32" Background="#78A65A" Foreground="White" FontWeight="SemiBold" Style="{StaticResource RoundedBtn}" Click="BtnConfirm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>