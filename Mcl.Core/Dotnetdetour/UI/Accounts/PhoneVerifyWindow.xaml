<Window x:Class="Mcl.Core.Dotnetdetour.UI.Forms.PhoneVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全验证" Height="360" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="需要安全验证" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock x:Name="SubTitleText" Text="为手机号进行安全验证" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,20" Grid.Row="1"/>

        <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel x:Name="UpstreamPanel" Visibility="Collapsed">
                    <TextBlock Text="请使用手机发送以下短信：" Margin="0,0,0,10"/>
                    <TextBlock x:Name="UpNumberText" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="UpContentText" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="发送成功后请点击下方检查按钮。" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel x:Name="CodePanel" Visibility="Visible">
                    <TextBlock Text="验证码已发送，请输入 6 位数字：" Margin="0,0,0,10"/>
                    <TextBox x:Name="CodeBox" Height="40" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" MaxLength="10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Button x:Name="VerifyBtn" Content="立即验证" Height="40" Style="{StaticResource PrimaryButton}" Click="OnVerifyClick"/>
        </StackPanel>
    </Grid>
</Window>