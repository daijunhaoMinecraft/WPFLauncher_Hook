<Window x:Class="Mcl.Core.Dotnetdetour.UI.Forms.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号编辑" Height="550" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,24,24,10">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="添加账号" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,24"/>
                <TextBlock Text="账号名称" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="NameInput" Height="36" Margin="0,0,0,20"/>
                <TextBlock Text="账号类型" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="RbCookie" Content="Cookie" Margin="0,0,20,0" Checked="OnTypeChanged" IsChecked="True"/>
                    <RadioButton x:Name="Rb4399" Content="4399" Margin="0,0,20,0" Checked="OnTypeChanged"/>
                    <RadioButton x:Name="RbPhone" Content="手机号" Margin="0,0,20,0" Checked="OnTypeChanged"/>
                    <RadioButton x:Name="RbEmail" Content="网易邮箱" Checked="OnTypeChanged"/>
                </StackPanel>
                <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel x:Name="PanelCookie" Visibility="Visible">
                            <TextBlock Text="Cookie 数据:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="CookieInput" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelUserPass" Visibility="Collapsed">
                            <TextBlock x:Name="UserLabel" Text="用户名/邮箱:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="UserInput" Height="36" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="密码:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PassInput" Height="36" Margin="0,0,12,0"/>
                                <TextBox x:Name="PassInputVisible" Height="36" Margin="0,0,12,0" Visibility="Collapsed"/>
                                <CheckBox x:Name="ShowPassCheck" Content="显示密码" Grid.Column="1" VerticalAlignment="Center" Checked="OnShowPassChanged" Unchecked="OnShowPassChanged"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="PanelPhone" Visibility="Collapsed">
                            <TextBlock Text="手机号:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="PhoneInput" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="备注 (可选)" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="NotesInput" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="100" Margin="0,0,12,0" Click="OnCancelClick"/>
                <Button Content="保存" Width="100" Style="{StaticResource PrimaryButton}" Margin="0,0,0,0" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>