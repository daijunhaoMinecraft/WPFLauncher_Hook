<Window x:Class="Mcl.Core.Dotnetdetour.UI.Forms.AccountSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多账号管理" Height="520" Width="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
            <RowDefinition Height="20"/>   
            <RowDefinition Height="85"/>   
        </Grid.RowDefinitions>
        <TextBlock Text="选择登录账号" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" 
                   Grid.Row="0" Grid.Column="0" Margin="0,0,0,24"/>
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListView x:Name="AccountListView" BorderThickness="0" Background="Transparent" Margin="4"
                      SelectionChanged="OnAccountSelected" MouseDoubleClick="OnListViewDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="账号名称" Width="170" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding TypeDisplay}"/>
                        <GridViewColumn Header="备注" Width="180" DisplayMemberBinding="{Binding Notes}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="8" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DetailTitleText" Text="选择一个账号查看详情" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="DetailContentText" Text="暂无详细信息" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="2">
            <Button x:Name="LoginButton" Content="登录选中账号" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" IsEnabled="False" Click="PerformLogin"/>
            
            <Button Content="添加账号" Margin="0,0,0,12" Click="OnAddClick"/>
            <Button x:Name="EditButton" Content="编辑账号" Margin="0,0,0,12" IsEnabled="False" Click="OnEditClick"/>
            <Button x:Name="DeleteButton" Content="删除账号" Margin="0,0,0,24" IsEnabled="False" Click="OnDeleteClick"/>
            
            <Separator Margin="0,0,0,24" Background="{DynamicResource BorderBrush}"/>
            
            <Button Content="手动输入 (一次性)" Margin="0,0,0,12" Click="OnManualClick"/>
            <Button Content="使用原版登录" Margin="0,0,0,12" Click="OnOriginalLoginClick"/>
        </StackPanel>
    </Grid>
</Window>