<Window x:Class="Mcl.Core.Dotnetdetour.UI.Forms.CaptchaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全验证" Height="280" Width="360"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="请输入图片中的验证码" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5" Width="140" Height="60">
                    <Image x:Name="CaptchaImage" Stretch="Uniform"/>
                </Border>
                <Button x:Name="RefreshBtn" Content="换一张" Margin="15,0,0,0" Height="36" VerticalAlignment="Center" Click="OnRefreshClick"/>
            </StackPanel>

            <TextBox x:Name="InputBox" Height="34" Margin="0,0,0,20" FontSize="14" HorizontalContentAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="取消" Width="100" Margin="0,0,15,0" Click="OnCancelClick"/>
                <Button Content="确定" Width="100" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirmClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>