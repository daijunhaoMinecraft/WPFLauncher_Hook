<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.UpdateConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mcl.Core 初始配置" Height="340" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}" Topmost="True"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="更新偏好设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <CheckBox x:Name="ChkDisable" Content="完全禁用更新检查" FontSize="15" Margin="0,0,0,15"/>

            <TextBlock Text="选择更新渠道 (推荐使用稳定版):" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
            <ComboBox x:Name="CmbChannel" FontSize="15" Height="34" Margin="0,0,0,25" Padding="8,4">
                <ComboBoxItem Content="Build版 (开发 - 激进更新)"/>
                <ComboBoxItem Content="Release版 (稳定 - 推荐)"/>
            </ComboBox>

            <Button x:Name="BtnSave" Content="保存并继续" Height="36" Width="120"
                    HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
