<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.UpdateConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mcl.Core 初始配置" Height="470" Width="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}" Topmost="True"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="更新偏好设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="ChannelText" Text="启动器更新渠道：正在识别…" Style="{StaticResource SecondaryText}"
                       FontSize="14"/>

            <TextBlock Text="启动器更新（官方 patchlist）" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <CheckBox x:Name="ChkDisableLauncher" Content="禁用启动器更新检查" FontSize="14"/>

            <TextBlock Text="插件更新（Mcl.Core.dll，GitHub）" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <CheckBox x:Name="ChkDisableHook" Content="禁用 Mcl.Core.dll 自更新检查" FontSize="14" Margin="0,0,0,10"/>
            <ComboBox x:Name="CmbChannel" FontSize="14" Height="32" Margin="0,0,0,4">
                <ComboBoxItem Content="Build 版（开发构建，激进的更新）"/>
                <ComboBoxItem Content="Release 版（稳定发行，推荐）"/>
            </ComboBox>

            <TextBlock Text="两条更新相互独立；禁用后宿主自带更新同样会被阻止，以保护钩子文件。"
                       Style="{StaticResource SecondaryText}" Margin="0,16,0,20"/>

            <Button x:Name="BtnSave" Content="保存并继续" Height="36" Width="120"
                    HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
