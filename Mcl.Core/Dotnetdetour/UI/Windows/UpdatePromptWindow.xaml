<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource UiFont}"
        ResizeMode="CanResize" Topmost="True"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TxtTitle" Text="发现新版本" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="包含以下新功能与改进：" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <FlowDocumentScrollViewer x:Name="LogViewer" Margin="10,5" VerticalScrollBarVisibility="Auto"/>
        </Border>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="在网页查看更改" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" Click="BtnViewChanges_Click" Margin="0,0,15,0" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="下载节点:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" FontSize="13"/>
                <ComboBox x:Name="CmbMirror" Width="125" Height="28" FontSize="13" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="自动 (推荐)" IsSelected="True"/>
                    <ComboBoxItem Content="GitHub 直连"/>
                    <ComboBoxItem Content="GH-Proxy 镜像"/>
                    <ComboBoxItem Content="GHProxy.net"/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNo" Style="{StaticResource SolidButton}" Content="暂不更新" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" Click="BtnNo_Click"/>
                <Button x:Name="BtnYes" Style="{StaticResource SolidButton}" Content="更新并重启" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Click="BtnYes_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>