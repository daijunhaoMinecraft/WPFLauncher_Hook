<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Segoe UI, Microsoft YaHei"
        ResizeMode="CanResize" Topmost="True">
    
    <Window.Resources>
        <!-- 默认按钮样式 -->
        <Style TargetType="Button" x:Key="SolidButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#20000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TxtTitle" Text="发现新版本" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock Text="包含以下新功能与改进：" FontSize="14" Foreground="#666666" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" Margin="0,0,0,20">
            <FlowDocumentScrollViewer x:Name="LogViewer" Margin="10,5" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 底部区域修改：加入节点选择 ComboBox 和伪装超链接的 Button -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- 伪装成超链接的纯 Button，彻底解决点不动的问题 -->
                <Button Content="在网页查看更改" Foreground="#005FB8" Cursor="Hand" Click="BtnViewChanges_Click" Margin="0,0,15,0" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="下载节点:" VerticalAlignment="Center" Foreground="#666666" Margin="0,0,8,0" FontSize="13"/>
                <ComboBox x:Name="CmbMirror" Width="125" Height="28" FontSize="13" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="自动 (推荐)" IsSelected="True"/>
                    <ComboBoxItem Content="GitHub 直连"/>
                    <ComboBoxItem Content="GH-Proxy 镜像"/>
                    <ComboBoxItem Content="GHProxy.net"/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNo" Style="{StaticResource SolidButton}" Content="暂不更新" Background="#F3F3F3" Foreground="#1A1A1A" Click="BtnNo_Click"/>
                <Button x:Name="BtnYes" Style="{StaticResource SolidButton}" Content="更新并重启" Background="#005FB8" Foreground="White" FontWeight="Bold" Click="BtnYes_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>