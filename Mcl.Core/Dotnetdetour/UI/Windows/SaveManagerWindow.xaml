<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.SaveManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="载入存档" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">

       <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="存档管理 (云端)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}"/>
            <Border Grid.Row="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="云端存储空间: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding StorageUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding StorageUsagePercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Height="6" Maximum="100" BorderThickness="0" Background="{DynamicResource ControlPressedBrush}" Foreground="{DynamicResource AccentBrush}">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </Border>
            <ListView x:Name="SaveListView" Grid.Row="2" Margin="15" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="15"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                                        </Border.Effect>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#78A65A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#78A65A"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F2F7EF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="4" Padding="5,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding BackupId, StringFormat='槽位 {0}'}" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding SaveId, StringFormat='Save ID: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding ResId, StringFormat='Res ID: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <TextBlock Text="{Binding SaveTime, StringFormat='保存时间: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding ExpireTime, StringFormat='过期时间: {0}'}" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="重命名" Tag="{Binding BackupId}" Click="BtnRename_Click"
                                        Margin="0,0,10,0" Padding="10,5" Background="{DynamicResource ControlBrush}" BorderThickness="0"/>
                                <Button Content="删除" Tag="{Binding BackupId}" Click="BtnDelete_Click"
                                        Padding="10,5" Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,12,12">
                <Grid>
                    <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource BorderBrush}"/>
                    <Button Content="刷新列表" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                            Width="90" Height="36" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                            Click="BtnRefresh_Click" Style="{StaticResource LargeRoundedBtn}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="取消" Width="100" Height="36" Margin="0,0,15,0"
                                Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                Click="BtnClose_Click" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="载入存档" Width="100" Height="36"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="BtnLoad_Click" Cursor="Hand" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
