<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.SaveBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存存档" Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded" Closed="Window_Closed">

    <!-- 复用之前的按钮样式 (放入 Window.Resources) -->
    <Window.Resources>
        <Style x:Key="SmallRoundedBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LargeRoundedBtn" TargetType="Button">
            <!-- 样式同上，圆角改为6，此处略过冗余代码，保持与之前相同即可 -->
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="12" BorderBrush="#E5E5E5" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Direction="270"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/> 
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>  
                <RowDefinition Height="65"/> 
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="保存存档 (云端备份)" FontWeight="Bold" FontSize="16" Foreground="#333333" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#E5E5E5"/>
            <!-- 🌟 新增：存储空间使用情况展示 -->
            <Border Grid.Row="1" Background="#FDFDFD" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="20,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="云端存储空间: " Foreground="#555555" FontSize="13"/>
                        <!-- 绑定到后台的 StorageUsageText 属性 -->
                        <TextBlock Text="{Binding StorageUsageText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Foreground="#333333" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
        
                    <!-- 容量进度条 -->
                    <ProgressBar Value="{Binding StorageUsagePercentage, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 Height="6" Maximum="100" BorderThickness="0" Background="#EAEAEA" Foreground="#78A65A">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- 存档列表 -->
            <ListView x:Name="SaveListView" Grid.Row="2" Margin="15" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <!-- 保持之前的 ListViewItem 样式不变 -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" Background="#FFFFFF" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#E5E5E5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#78A65A"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 信息展示同之前 -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#222222"/>
                                    <Border Background="#E6F4EA" CornerRadius="4" Padding="5,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding BackupId, StringFormat='槽位 {0}'}" FontSize="12" Foreground="#1E8E3E"/>
                                    </Border>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding SaveTime, StringFormat='保存时间: {0}'}" FontSize="12" Foreground="#777777"/>
                                    <TextBlock Text="{Binding FormattedSize, StringFormat='大小: {0}'}" FontSize="12" Foreground="#777777"/>
                                </UniformGrid>
                            </StackPanel>

                            <!-- 操作按钮区 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 🌟 新增：覆盖按钮 -->
                                <Button Content="覆盖" Tag="{Binding BackupId}" Click="BtnOverwrite_Click"
                                        Margin="0,0,10,0" Padding="15,6" Background="#E6F4EA" Foreground="#1E8E3E" Style="{StaticResource SmallRoundedBtn}"/>
                                <Button Content="重命名" Tag="{Binding BackupId}" Click="BtnRename_Click"
                                        Margin="0,0,10,0" Padding="15,6" Background="#F1F3F4" Style="{StaticResource SmallRoundedBtn}"/>
                                <Button Content="删除" Tag="{Binding BackupId}" Click="BtnDelete_Click"
                                        Padding="15,6" Background="#FCE8E6" Foreground="#D93025" Style="{StaticResource SmallRoundedBtn}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 底部按钮区 -->
            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="0,0,12,12">
                <Grid>
                    <Border VerticalAlignment="Top" Height="1" Background="#E5E5E5"/>
                    <Button Content="刷新列表" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                            Width="90" Height="36" Background="#F1F3F4" Foreground="#333333" FontWeight="SemiBold"
                            Click="BtnRefresh_Click" Style="{StaticResource LargeRoundedBtn}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="取消" Width="100" Height="36" Margin="0,0,15,0" 
                                Background="#A67B5B" Foreground="White" FontWeight="SemiBold"
                                Click="BtnClose_Click" Style="{StaticResource LargeRoundedBtn}"/>
                        
                        <!-- 🌟 修改为：新建备份按钮 -->
                        <Button Content="新建备份" Width="120" Height="36" 
                                Background="#78A65A" Foreground="White" FontWeight="SemiBold"
                                Click="BtnNewBackup_Click" Style="{StaticResource LargeRoundedBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>