<Window x:Class="Mcl.Core.Dotnetdetour.UI.Windows.LauncherUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器更新" Width="560" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mcl.Core;component/Dotnetdetour/UI/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource SelectionBrush}">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="启动器更新" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnCloseX" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.Name="关闭" Click="BtnClose_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Row="1" Margin="24,20,24,8">
                <StackPanel x:Name="PromptPanel">
                    <TextBlock Text="发现启动器新版本" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ChannelText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12"
                                Background="{DynamicResource SubtleSurfaceBrush}">
                            <StackPanel>
                                <TextBlock Text="当前版本" Style="{StaticResource SecondaryText}"/>
                                <TextBlock x:Name="CurrentVersionText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12"
                                Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel>
                                <TextBlock Text="最新版本" Style="{StaticResource SecondaryText}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="NewestVersionText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="更新内容" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="0" Height="180">
                        <ScrollViewer x:Name="NotesScroll" Padding="14,12" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="SizeText" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel x:Name="WorkingPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StageTitle" Text="正在下载更新包…" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StageDetail" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>

                    <ProgressBar x:Name="StageProgress" Height="6" Margin="0,24,0,0" Minimum="0" Maximum="100" Value="0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="PercentText" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TrafficText" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Border x:Name="StepDownloadChip" CornerRadius="12" Padding="12,5"
                                Background="{DynamicResource SubtleSurfaceBrush}">
                            <TextBlock x:Name="StepDownloadText" Text="下载" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                        <Border x:Name="StepExtractChip" CornerRadius="12" Padding="12,5" Margin="8,0,0,0"
                                Background="{DynamicResource SubtleSurfaceBrush}">
                            <TextBlock x:Name="StepExtractText" Text="解压" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                        <Border x:Name="StepApplyChip" CornerRadius="12" Padding="12,5" Margin="8,0,0,0"
                                Background="{DynamicResource SubtleSurfaceBrush}">
                            <TextBlock x:Name="StepApplyText" Text="应用" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ReadyPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                            Background="{DynamicResource SuccessBackgroundBrush}">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="更新已准备完成" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="ReadyDetail" Text="启动器即将自动重启以应用更新…"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Width="220" Margin="0,24,0,0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="2"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                            Background="{DynamicResource DangerBackgroundBrush}">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="更新失败" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource SecondaryText}" MaxWidth="430"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="24,10,24,20">
                <Grid>
                    <TextBlock x:Name="FooterHint" Style="{StaticResource SecondaryText}" MaxWidth="290"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="更新完成后启动器会自动重新启动。"/>
                    <StackPanel x:Name="PromptButtons" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLater" Content="稍后" MinWidth="96" Click="BtnLater_Click"/>
                        <Button x:Name="BtnUpdate" Content="立即更新" MinWidth="132" Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}" Click="BtnUpdate_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="WorkButtons" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCancel" Content="取消更新" MinWidth="96" Click="BtnCancel_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="ErrorButtons" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnErrorClose" Content="关闭" MinWidth="96" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
