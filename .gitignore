# Reproducible build and test output. Existing copies stay local but are not uploaded.
**/bin/
**/obj/
**/TestResults/
**/.artifacts/
packages/
*.pdb
*.cache
*.up2date
*.info
*.nupkg
*.snupkg

# IDE and machine-specific settings.
.idea/
.vs/
_ReSharper*/
*.suo
*.user

# Local coding-agent and graph state.
.claude/
.codegraph/
.omo/

# Local-only refactor notes are not part of the repository.
/REFACTOR_PLAN.md

# Local runtime, account, and validation data.
/MCLauncherDebug/
/.private-build/
/config.json
**/MclUpdateConfig.json
**/RoomConfig/
*.log
*.tmp
*.bak
*.orig
*.rej
*.7z

# Proprietary launcher binaries belong only in WPFLauncher_Hook_Build.
**/WPFLauncher*.exe
**/WPFLauncher*.dll
**/WPFControls.dll
**/CefSharp*.dll

# Share only Rider launch definitions, never the local host or account data.
/.run/*
!/.run/*.run.xml
